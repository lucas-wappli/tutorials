<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate_property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new property.
            </p>
        </field>

    </record>

    <menuitem id="estate_property_menu_root" 
              name="Real Estate"/>

    <menuitem id="estate_menu_first_level" 
              name="Advertissements" 
              parent="estate_property_menu_root"/>

    <menuitem id="estate_menu_properties"
              name="Properties"
              action="estate_property_action"
              parent="estate_menu_first_level"/>
</odoo>
